/*
  # === SEGURIDAD: Headers HTTP ===

  # Prevenir clickjacking (no permitir embedding en iframes)
  X-Frame-Options: DENY

  # Prevenir MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Activar XSS filter del navegador
  X-XSS-Protection: 1; mode=block

  # Controlar información enviada como referrer
  Referrer-Policy: strict-origin-when-cross-origin

  # Content Security Policy — solo recursos propios + WhatsApp + Instagram
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none';

  # Restringir APIs del navegador que no se usan
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

  # Forzar HTTPS (HSTS) — 1 año con subdominios
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Evitar que el sitio aparezca en resultados de FLoC (tracking de Google)
  X-Permitted-Cross-Domain-Policies: none

  # Cross-Origin policies
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: unsafe-none
